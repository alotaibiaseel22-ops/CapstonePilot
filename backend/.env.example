APP_ENV=development
# SQLite is fine for local dev, but does not survive a production host's
# ephemeral filesystem across restarts/redeploys - in production this must
# point at a real Postgres instance (e.g. Render's managed Postgres), e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./capstonepilot.db
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Guest-access (shareable-link, no-account) settings - optional, both have
# working defaults. GUEST_ACCESS_TOKEN_EXPIRE_MINUTES is how long a joined
# guest's browser session lasts; INVITATION_LINK_EXPIRE_DAYS is how long the
# link itself stays redeemable at all - two independent lifetimes, see
# app/infrastructure/security/jwt.py and application/services/invitation_service.py.
GUEST_ACCESS_TOKEN_EXPIRE_MINUTES=10080
INVITATION_LINK_EXPIRE_DAYS=30
# Preferred: set one or more numbered keys to enable automatic rotation past
# a rate-limited/quota-exhausted key (see app/infrastructure/agents/gemini_client.py).
# One key is enough - GEMINI_API_KEY_1 alone works fine, rotation just won't
# have anywhere to rotate to.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Legacy single-key var - only used as a fallback if none of the numbered
# keys above are set. Existing deployments with only this set keep working.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# JSON array, not comma-separated - e.g. CORS_ORIGINS=["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:5173"]

FRONTEND_URL=http://localhost:5173

# Automatic Risk/Recommendation monitoring background loop.
ENABLE_SCHEDULER=true
MONITORING_INTERVAL_SECONDS=1800

# Optional: leave SMTP_HOST empty to log invitation emails to the console
# instead of sending them (useful for local dev without real credentials).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@capstonepilot.app
SMTP_USE_TLS=true
