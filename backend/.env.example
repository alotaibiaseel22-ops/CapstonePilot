APP_ENV=development
DATABASE_URL=sqlite:///./capstonepilot.db
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OPENROUTER_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]

FRONTEND_URL=http://localhost:5173

# Optional: leave SMTP_HOST empty to log invitation emails to the console
# instead of sending them (useful for local dev without real credentials).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@capstonepilot.app
SMTP_USE_TLS=true
